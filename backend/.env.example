# OpenAI-compatible chat and embedding endpoint. Never commit a real key.
# Safe default: reproducible offline model + lexical retrieval.
LLM_PROVIDER=deterministic
RETRIEVAL_PROVIDER=lexical
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional: use a different OpenAI-compatible provider for embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Leave unset when the provider enforces its own temperature (for example Kimi K3).
# LLM_TEMPERATURE=0

# To exercise a real OpenAI-compatible model and vector retrieval, set:
# LLM_PROVIDER=openai_compatible
# RETRIEVAL_PROVIDER=vector

AGENT_API_URL=http://agent-api:8000
MOCK_ERP_BASE_URL=http://mock-erp:8001
COPILOT_DB_PATH=/app/runtime/copilot.db
ERP_DB_PATH=/app/runtime/erp.db
CHROMA_PATH=/app/runtime/chroma
KNOWLEDGE_BASE_PATH=/app/knowledge_base
LOG_LEVEL=INFO
MAX_TOOL_ROUNDS=2
RAG_TOP_K=3
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTO_BUILD_INDEX=true

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-support-copilot
